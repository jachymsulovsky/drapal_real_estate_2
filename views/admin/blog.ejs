<%- include('../partials/admin-head') %>
<%- include('../partials/admin-nav') %>
<section class="admin-header">
  <div>
    <p class="eyebrow">Obsah webu</p>
    <h1>Blog</h1>
  </div>
  <a class="button secondary" href="/admin/blog/new">+ Nový článek</a>
</section>

<section class="admin-card">
  <h2>Seznam článků</h2>
  <div class="table-wrap">
    <table>
      <thead><tr><th>Nadpis</th><th>Autor</th><th>Publikováno</th><th>Akce</th></tr></thead>
      <tbody>
        <% posts.forEach((post) => { %>
          <tr>
            <td><%= post.title %></td>
            <td><%= post.author_name || 'Drápal Real Estate' %></td>
            <td><%= post.published_at %></td>
            <td>
              <a class="button secondary small" href="/admin/blog/<%= post.id %>/edit">Upravit</a>
              <form method="post" action="/admin/blog/<%= post.id %>/delete" style="display:inline;" onsubmit="return confirm('Smazat článek?')">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button class="button danger small" type="submit">Smazat</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>

<%- include('../partials/admin-foot') %>